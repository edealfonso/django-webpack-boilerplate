# Copy this file to `.env` and fill in your values. Never commit `.env`.
# In development (`docker compose up`) every value has a default, so `.env` is optional.
# In production (`compose.prod.yml`) SECRET_KEY, POSTGRES_* and ALLOWED_HOSTS are required.

# Generate one with:
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# PostgreSQL (used by the db container and to build DATABASE_URL for web).
# Avoid URL special characters (@ : / ? #) in the password.
POSTGRES_DB=myproject
POSTGRES_USER=myproject
POSTGRES_PASSWORD=change-me

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Production HTTPS (see config/settings/prod.py)
# SECURE_HTTPS=False          # only to try compose.prod.yml over plain http
# SECURE_HSTS_SECONDS=3600    # raise to 31536000 once HTTPS is confirmed

# Optional host ports
# WEB_PORT=8000
# DB_PORT=5432
# HTTP_PORT=80

# Only when running Django outside Docker (compose sets it for you):
# DATABASE_URL=postgres://myproject:change-me@localhost:5432/myproject
