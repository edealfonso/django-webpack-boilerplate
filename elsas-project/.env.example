# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myproject

# Local only (prod.py always uses DEBUG=False)
DEBUG=True

# Comma-separated. Required in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
